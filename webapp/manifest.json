{
  "_version": "1.60.0",
  "sap.app": {
    "id": "com.jhah.zhrjhahsectvs",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.26.0",
      "toolsId": "6c91af38-1dd3-4f36-a5eb-3af9577b999f"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsrv_hr_tvs_o4/srvd/sap/zsrv_hr_tvs/0001/",
        "type": "OData",
        "settings": {
          "annotations": ["annotation"],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.39",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": false
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.jhah.zhrjhahsectvs.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "headerList",
          "target": "headerList"
        },
        {
          "pattern": "header({key}):?query:",
          "name": "headerObjectPage",
          "target": "headerObjectPage"
        },
        {
          "pattern": "header({key})/_Evidence({key2}):?query:",
          "name": "evidenceObjectPage",
          "target": "evidenceObjectPage"
        }
      ],
      "targets": {
        "headerList": {
          "type": "Component",
          "id": "headerList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/header",
              "variantManagement": "Page",
              "views": {
                "paths": [
                  {
                    "key": "AdminTabKey",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#AdminTab"
                  },
                  {
                    "key": "EmpTabKey",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#EmpTab"
                  }
                ],
                "showCounts": false
              },
              "navigation": {
                "header": {
                  "detail": {
                    "route": "headerObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem#AdminList": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "MaintainViolMasterData": {
                      "type": "Menu",
                      "text": "Maintain Master Data",
                      "menu": [
                        "NavMaintainLocation",
                        "NavMaintainViolationType",
                        "NavMaintainWFRule",
                        "NavMaintainWFAdmin"
                      ]
                    },
                    "NavMaintainLocation": {
                      "text": "Maintain Location",
                      "icon": "sap-icon://map-2",
                      "press": "com.jhah.zhrjhahsectvs.ext.controller.CustomActions.navigateToMaintainLocation"
                    },
                    "NavMaintainViolationType": {
                      "text": "Maintain Violation Type",
                      "icon": "sap-icon://warning2",
                      "press": "com.jhah.zhrjhahsectvs.ext.controller.CustomActions.navigateToMaintainViolationType"
                    },
                    "NavMaintainWFRule": {
                      "text": "Maintain Workflow Rules",
                      "icon": "sap-icon://workflow-tasks",
                      "press": "com.jhah.zhrjhahsectvs.ext.controller.CustomActions.navigateToMaintainWFRule"
                    },
                     "NavMaintainWFAdmin": {
                      "text": "Maintain Workflow Admin",
                      "icon": "sap-icon://manager",
                      "press": "com.jhah.zhrjhahsectvs.ext.controller.CustomActions.navigateToMaintainWFAdmin"
                    }
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem#EmpList": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "headerObjectPage": {
          "type": "Component",
          "id": "headerObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/header",
              "enhanceI18n": "i18n/i18n.properties",
              "content": {
                "header": {
                  "facets": {
                    "customViolatorStrip": {
                      "type": "XMLFragment",
                      "name": "com.jhah.zhrjhahsectvs.ext.fragment.ViolatorStrip"
                    }
                  }
                }
              },
              "navigation": {
                "_Evidence": {
                  "detail": {
                    "route": "evidenceObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_Evidence/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "Inline"
                    }
                  }
                }
              }
            }
          }
        },
        "evidenceObjectPage": {
          "type": "Component",
          "id": "evidenceObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/header/_Evidence"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#com.jhah.zhrjhahsectvs::headerList": {
            "controllerName": "com.jhah.zhrjhahsectvs.ext.controller.ViolationControllerExtension"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController#com.jhah.zhrjhahsectvs::headerObjectPage": {
            "controllerName": "com.jhah.zhrjhahsectvs.ext.controller.ViolationControllerExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}

        <!-- THIN STRIP: Violation Stats -->
        <HBox 
            visible="{= (${violator>/ViolationCountLast12Months} * 1 > 0) || (${violator>/TotalPointsLast12Months} * 1 > 0) || (${violator>/LifetimeViolationsCount} * 1 > 0) || (${violator>/InProgressViolationCount} * 1 > 0) }" 
            width="100%" 
            class="nativeViolatorStripThin" 
            wrap="Wrap" 
            justifyContent="SpaceBetween" 
            alignItems="Center">
            
            <HBox class="violatorRowThin" alignItems="Center">
                <Text text="Violations (12M):" class="violatorLabelThin sapUiTinyMarginEnd" />
                <Text text="{= ${violator>/ViolationCountLast12Months} ? ${violator>/ViolationCountLast12Months} : '0' }" class="{= (${violator>/ViolationCountLast12Months} * 1 > 0) ? 'violatorValueThin highlightStat' : 'violatorValueThin' }" />
            </HBox>

            <HBox class="violatorRowThin" alignItems="Center">
                <Text text="Points (12M):" class="violatorLabelThin sapUiTinyMarginEnd" />
                <Text text="{= ${violator>/TotalPointsLast12Months} ? ${violator>/TotalPointsLast12Months} : '0' }" class="{= (${violator>/TotalPointsLast12Months} * 1 > 0) ? 'violatorValueThin highlightStat' : 'violatorValueThin' }" />
            </HBox>

            <HBox class="violatorRowThin" alignItems="Center">
                <Text text="In-Progress:" class="violatorLabelThin sapUiTinyMarginEnd" />
                <Text text="{= ${violator>/InProgressViolationCount} ? ${violator>/InProgressViolationCount} : '0' }" class="{= (${violator>/InProgressViolationCount} * 1 > 0) ? 'violatorValueThin highlightStat' : 'violatorValueThin' }" />
            </HBox>

            <HBox class="violatorRowThin" alignItems="Center">

            class="customKpiBox"
            tooltip="Escalated to approvers automatically when time expires">
            
            <Text text="Cooling Off Period" class="customKpiTitle" />
            <HBox alignItems="Center">
                <core:Icon src="sap-icon://fob-watch" class="sapUiTinyMarginEnd customKpiIcon" size="1.25rem"/>

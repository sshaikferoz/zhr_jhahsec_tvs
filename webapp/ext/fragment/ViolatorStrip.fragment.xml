            </HBox>

            <HBox class="violatorRowThin" alignItems="Center">
                <Text text="Last Violation Date:" class="violatorLabelThin sapUiTinyMarginEnd" />
                <Text text="{= ${violator>/LastViolationDate} ? ${violator>/LastViolationDate}.substring(5,7) + '/' + ${violator>/LastViolationDate}.substring(8,10) + '/' + ${violator>/LastViolationDate}.substring(0,4) : 'N/A' }" class="violatorValueThin" />
